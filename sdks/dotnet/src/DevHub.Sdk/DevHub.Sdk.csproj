<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>
      <!-- 这个空标签用于清空工作区 Directory.Build.props 继承的单目标框架配置，避免与当前项目的多目标配置冲突。 -->
    </TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>DevHub.Sdk</RootNamespace>
    <AssemblyName>DevHub.Sdk</AssemblyName>
    <PackageId>DevHub.Sdk.DotNet</PackageId>
    <Description>DevHub 协议的 .NET SDK，提供 runtime discovery、HTTP JSON-RPC 与 WebSocket events 客户端。</Description>
    <Authors>DevHub Contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SolarianZ/DevHub</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SolarianZ/DevHub.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>DevHub;SDK;JSON-RPC;WebSocket;RPC</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
