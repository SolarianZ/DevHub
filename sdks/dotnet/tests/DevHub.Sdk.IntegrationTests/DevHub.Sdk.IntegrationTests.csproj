<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>DevHub.Sdk.IntegrationTests</RootNamespace>
    <AssemblyName>DevHub.Sdk.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Json.Net.Unity3D" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" VersionOverride="17.14.1" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevHub.Sdk\DevHub.Sdk.csproj" />
    <ProjectReference Include="..\..\..\..\host\src\DevHub.Host\DevHub.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SetConfiguration="Configuration=$(Configuration)"
                      SetPlatform="Platform=$(Platform)" />
  </ItemGroup>

  <Target Name="NormalizeHostProjectReferenceConfiguration" AfterTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Update="..\..\..\..\host\src\DevHub.Host\DevHub.Host.csproj">
        <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=$(Platform)</SetPlatform>
      </ProjectReferenceWithConfiguration>
      <_ProjectReferenceWithConfiguration Update="..\..\..\..\host\src\DevHub.Host\DevHub.Host.csproj">
        <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=$(Platform)</SetPlatform>
      </_ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
