{
    "rust-analyzer.linkedProjects": [
        "apps/monitor/src-tauri/Cargo.toml"
    ],
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.cargo.targetDir": true,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "files.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/.vs": true,
        "**/.idea": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/.vs": true,
        "**/.idea": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true
    },
    "dotnet.defaultSolution": "host/DevHub.slnx"
}