<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevHub.Host</RootNamespace>
    <AssemblyName>DevHub.Host</AssemblyName>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevHub.Core\DevHub.Core.csproj" />
  </ItemGroup>

  <Target Name="NormalizeCoreProjectReferenceConfiguration" AfterTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Update="..\DevHub.Core\DevHub.Core.csproj">
        <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=$(Platform)</SetPlatform>
      </ProjectReferenceWithConfiguration>
      <_ProjectReferenceWithConfiguration Update="..\DevHub.Core\DevHub.Core.csproj">
        <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=$(Platform)</SetPlatform>
      </_ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>

</Project>
