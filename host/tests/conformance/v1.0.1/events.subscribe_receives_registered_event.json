{
  "id": "events.subscribe_receives_registered_event",
  "caseId": "CONF-007",
  "description": "通过 SDK EventsClient 订阅 app.instance.registered 后，注册实例必须收到 hub.event。",
  "transport": "ws",
  "setup": {
    "definitions": [
      {
        "appId": "events.subscribe.registered",
        "scopeEntry": {
          "scope": "",
          "displayName": "events.subscribe.registered"
        }
      }
    ]
  },
  "request": {
    "kind": "sdk.events",
    "clientId": "ConformanceEventsSubscribe",
    "steps": [
      {
        "action": "create_events_client",
        "client": "events"
      },
      {
        "action": "authenticate",
        "client": "events"
      },
      {
        "action": "subscribe",
        "client": "events",
        "types": [
          "app.instance.registered"
        ],
        "captureAs": "subscriptionId"
      },
      {
        "action": "create_http_client",
        "client": "http"
      },
      {
        "action": "register_instance",
        "client": "http",
        "password": "conformance-password",
        "instance": {
          "instanceId": "events-register-inst-1",
          "appId": "events.subscribe.registered",
          "scope": "",
          "pid": 33001,
          "invoke": {
            "poll": true,
            "respond": true
          }
        }
      },
      {
        "action": "read_event",
        "client": "events",
        "captureAs": "event"
      }
    ]
  },
  "expectedResponse": {
    "phase": "sdk-events",
    "outcome": "success",
    "actual": {
      "subscriptionId": "${ANY_NON_EMPTY_STRING}",
      "event": {
        "subscriptionId": "${ANY_NON_EMPTY_STRING}",
        "type": "app.instance.registered",
        "payload": {
          "appId": "events.subscribe.registered",
          "instanceId": "events-register-inst-1",
          "scope": ""
        }
      }
    },
    "forbidPaths": [
      "$.actual.event.payload.password",
      "$.actual.event.payload.instanceSessionToken"
    ]
  },
  "tags": [
    "events",
    "ws",
    "sdk"
  ]
}
