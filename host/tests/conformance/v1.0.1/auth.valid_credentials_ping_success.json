{
  "id": "auth.valid_credentials_ping_success",
  "description": "携带有效 token 与必需请求头时，hub.ping 必须成功。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "Conformance",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000001"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "auth-valid-credentials",
    "method": "hub.ping",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "auth-valid-credentials",
    "result": {
      "ok": true,
      "serverTimeUtc": "${ANY_ISO_UTC}"
    }
  },
  "tags": [
    "auth",
    "http",
    "success"
  ]
}
