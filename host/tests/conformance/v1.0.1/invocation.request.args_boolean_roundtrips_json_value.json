{
  "id": "invocation.request.args_boolean_roundtrips_json_value",
  "caseId": "CONF-004",
  "description": "SDK request 的 args=boolean 必须原样投递给 callee。",
  "transport": "http",
  "setup": {
    "definitions": [
      {
        "appId": "invoke.request.args-boolean",
        "scopeEntry": {
          "scope": "",
          "displayName": "invoke.request.args-boolean"
        }
      }
    ]
  },
  "orchestration": {
    "beforeCaller": [
      {
        "action": "register_instance",
        "password": "conformance-password",
        "instance": {
          "instanceId": "request-args-boolean-inst",
          "appId": "invoke.request.args-boolean",
          "scope": "",
          "pid": 32207,
          "invoke": {
            "poll": true,
            "respond": true
          }
        }
      }
    ],
    "duringCaller": [
      {
        "action": "poll_expect_invocation",
        "instanceId": "request-args-boolean-inst",
        "waitMs": 1500,
        "expected": {
          "appId": "invoke.request.args-boolean",
          "method": "demo.request.args-boolean",
          "kind": "request",
          "args": false
        }
      },
      {
        "action": "respond_value",
        "instanceId": "request-args-boolean-inst",
        "value": {
          "handled": "boolean"
        }
      }
    ]
  },
  "request": {
    "kind": "sdk.request",
    "clientId": "ConformanceRequestArgsBoolean",
    "invokeRequest": {
      "appId": "invoke.request.args-boolean",
      "method": "demo.request.args-boolean",
      "args": false,
      "target": {
        "scope": ""
      },
      "options": {
        "ttlMs": 5000,
        "waitTimeoutMs": 3000,
        "queueIfOffline": false,
        "autoLaunch": false
      }
    }
  },
  "expectedResponse": {
    "phase": "sdk-invocation",
    "operation": "request",
    "outcome": "success",
    "actual": {
      "ok": true,
      "invocationId": "${ANY_NON_EMPTY_STRING}",
      "value": {
        "handled": "boolean"
      }
    }
  },
  "tags": [
    "invocation",
    "request",
    "args",
    "json-value",
    "sdk"
  ]
}
