{
  "id": "apps.instances.get_missing_returns_instance_not_found",
  "caseId": "CONF-003",
  "description": "获取不存在的实例时，hub.apps.getInstance 必须返回 instance_not_found。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000035"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-instances-get-missing",
    "method": "hub.apps.getInstance",
    "params": {
      "instanceId": "apps-instance-get-missing"
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-instances-get-missing",
    "error": {
      "code": -32010,
      "message": "instance_not_found",
      "data": {
        "reason": "unknown_instance",
        "instanceId": "apps-instance-get-missing"
      }
    }
  },
  "tags": [
    "apps",
    "instances",
    "http",
    "error"
  ]
}
