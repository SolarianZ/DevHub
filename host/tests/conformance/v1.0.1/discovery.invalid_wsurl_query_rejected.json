{
  "id": "discovery.invalid_wsurl_query_rejected",
  "caseId": "CONF-001",
  "description": "SDK 读取 hub.json 时必须拒绝携带 query 的 wsUrl。",
  "transport": "http",
  "setup": {
    "runtime": {
      "mode": "copy_host_runtime"
    },
    "dataDir": {
      "files": [
        {
          "path": "runtime/hub.json",
          "json": {
            "protocolVersion": 1,
            "pid": 47231,
            "httpBaseUrl": "${HOST_HTTP_BASE_URL}",
            "wsUrl": "ws://127.0.0.1:47231/ws?debug=true",
            "tokenFile": "${VECTOR_TOKEN_FILE}",
            "startedAtUtc": "2026-03-28T12:34:56Z",
            "runtimeTuning": {
              "leaseSeconds": 30,
              "onlineThresholdSeconds": 30,
              "launchDedupeWindowSeconds": 30,
              "launchRegisterTimeoutSeconds": 30
            }
          }
        }
      ]
    }
  },
  "request": {
    "kind": "discovery",
    "clientId": "ConformanceDiscoveryInvalidWsQuery",
    "dataDir": "${VECTOR_DATA_DIR}",
    "useEnvironmentDataDir": false
  },
  "expectedResponse": null,
  "expectedDiscovery": {
    "phase": "discovery",
    "outcome": "error",
    "actual": {
      "reason": "invalid_runtime",
      "message": "${ANY_NON_EMPTY_STRING}"
    }
  },
  "tags": [
    "discovery",
    "runtime",
    "wsUrl",
    "error"
  ]
}
