{
  "id": "auth.notification_protocol_mismatch_returns_not_supported",
  "caseId": "CONF-002",
  "description": "HTTP notification 的协议头无效时，Hub 必须返回 not_supported 而不是空响应。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "2",
      "X-DevHub-ClientId": "Conformance",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000203"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "method": "hub.ping",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": null,
    "error": {
      "code": -32099,
      "message": "not_supported",
      "data": {
        "expected": 1,
        "received": "2",
        "reason": "mismatch"
      }
    }
  },
  "tags": [
    "auth",
    "http",
    "notification",
    "negative"
  ]
}
