{
  "id": "apps.definitions.validate_valid_returns_no_errors",
  "caseId": "CONF-003",
  "description": "校验合法 AppDefinition 时，hub.apps.validateDefinition 必须返回 valid=true 且 errors 为空。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000033"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-validate-valid",
    "method": "hub.apps.validateDefinition",
    "params": {
      "definition": {
        "appId": "apps.validate.valid.app",
        "displayName": "Apps Validate Valid"
      }
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-validate-valid",
    "result": {
      "ok": true,
      "valid": true,
      "errors": []
    }
  },
  "tags": [
    "apps",
    "definitions",
    "http",
    "success"
  ]
}
