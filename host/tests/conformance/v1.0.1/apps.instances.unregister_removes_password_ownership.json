{
  "id": "apps.instances.unregister_removes_password_ownership",
  "caseId": "CONF-003",
  "description": "实例注销成功后，后续同 instanceId 使用新密码注册必须按首次注册处理。",
  "transport": "http",
  "orchestration": {
    "beforeCaller": [
      {
        "action": "register_instance",
        "password": "first-password",
        "instance": {
          "instanceId": "apps-instance-password-cleanup",
          "appId": "apps.instance.password-cleanup.app",
          "scope": "",
          "pid": 32101,
          "invoke": {
            "poll": true,
            "respond": true
          }
        }
      },
      {
        "action": "call_rpc",
        "method": "hub.apps.unregisterInstance",
        "requestId": "apps-instances-unregister-password-cleanup-setup",
        "params": {
          "instanceId": "apps-instance-password-cleanup"
        },
        "expectedResult": {
          "ok": true
        }
      }
    ]
  },
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000208"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-instances-reregister-after-unregister",
    "method": "hub.apps.registerInstance",
    "params": {
      "password": "second-password",
      "instance": {
        "instanceId": "apps-instance-password-cleanup",
        "appId": "apps.instance.password-cleanup.app",
        "scope": "",
        "pid": 32102,
        "invoke": {
          "poll": true,
          "respond": true
        }
      }
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-instances-reregister-after-unregister",
    "result": {
      "ok": true,
      "instanceSessionToken": "${ANY_NON_EMPTY_STRING}",
      "instance": {
        "instanceId": "apps-instance-password-cleanup",
        "appId": "apps.instance.password-cleanup.app",
        "scope": "",
        "pid": 32102,
        "registeredAtUtc": "${ANY_ISO_UTC}",
        "lastSeenUtc": "${ANY_ISO_UTC}",
        "invoke": {
          "poll": true,
          "respond": true
        }
      }
    }
  },
  "tags": [
    "apps",
    "instances",
    "http",
    "password"
  ]
}
