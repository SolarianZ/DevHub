{
  "id": "apps.definitions.list_ignores_invalid_definition_files",
  "caseId": "CONF-003",
  "description": "存在无效定义文件时，hub.apps.listDefinitions 必须忽略它们并仅返回合法定义。",
  "transport": "http",
  "setup": {
    "definitions": [
      {
        "fileName": "apps.list.valid-only.app--global.json",
        "definition": {
          "appId": "apps.list.valid-only.app",
          "scope": "",
          "displayName": "Apps List Valid Only"
        }
      },
      {
        "fileName": "apps.list.invalid-only.app.json",
        "rawText": "{\"appId\": \"apps.list.invalid-only.app\","
      }
    ]
  },
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000022"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-list-ignore-invalid",
    "method": "hub.apps.listDefinitions",
    "params": {
      "scope": null
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-list-ignore-invalid",
    "result": {
      "ok": true,
      "definitions": [
        {
          "appId": "apps.list.valid-only.app",
          "scope": "",
          "displayName": "Apps List Valid Only"
        }
      ]
    }
  },
  "tags": [
    "apps",
    "definitions",
    "http",
    "invalid-definition"
  ]
}
