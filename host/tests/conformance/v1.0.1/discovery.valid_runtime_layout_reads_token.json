{
  "id": "discovery.valid_runtime_layout_reads_token",
  "caseId": "CONF-001",
  "description": "SDK 必须从 <dataDir>/runtime/hub.json 读取端点，并继续通过 tokenFile 读取令牌。",
  "transport": "http",
  "setup": {
    "runtime": {
      "mode": "copy_host_runtime"
    }
  },
  "request": {
    "kind": "discovery",
    "clientId": "ConformanceDiscovery",
    "dataDir": "${VECTOR_DATA_DIR}",
    "useEnvironmentDataDir": false
  },
  "expectedResponse": null,
  "expectedDiscovery": {
    "phase": "discovery",
    "outcome": "success",
    "actual": {
      "runtimeDirectory": "${VECTOR_RUNTIME_DIR}",
      "token": "${HOST_TOKEN}",
      "runtime": {
        "protocolVersion": 1,
        "pid": "${HOST_PID}",
        "httpBaseUrl": "${HOST_HTTP_BASE_URL}",
        "wsUrl": "${HOST_WS_URL}",
        "tokenFile": "${VECTOR_TOKEN_FILE}",
        "startedAtUtc": "${ANY_ISO_UTC}",
        "runtimeTuning": {
          "leaseSeconds": "${HOST_RUNTIME_TUNING_LEASE_SECONDS}",
          "onlineThresholdSeconds": "${HOST_RUNTIME_TUNING_ONLINE_THRESHOLD_SECONDS}",
          "launchDedupeWindowSeconds": "${HOST_RUNTIME_TUNING_LAUNCH_DEDUPE_WINDOW_SECONDS}",
          "launchRegisterTimeoutSeconds": "${HOST_RUNTIME_TUNING_LAUNCH_REGISTER_TIMEOUT_SECONDS}"
        },
        "hubVersion": "${HOST_HUB_VERSION}"
      }
    },
    "matchMode": "subset"
  },
  "tags": [
    "discovery",
    "runtime",
    "token"
  ]
}
