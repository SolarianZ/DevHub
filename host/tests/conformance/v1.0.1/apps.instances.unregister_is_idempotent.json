      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000029"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-instances-unregister-missing",
    "method": "hub.apps.unregisterInstance",
    "params": {
