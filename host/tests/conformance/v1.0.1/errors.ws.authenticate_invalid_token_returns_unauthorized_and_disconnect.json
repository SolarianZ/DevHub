{
  "id": "errors.ws.authenticate_invalid_token_returns_unauthorized_and_disconnect",
  "description": "WS 使用非法 token 鉴权时，必须返回 unauthorized/invalid_token 且断开连接。", 
  "transport": "ws",
  "request": {
    "kind": "raw.ws",
    "steps": [
      {
        "action": "send",
        "message": {
          "jsonrpc": "2.0",
          "id": "ws-auth-invalid-token",
          "method": "hub.ws.authenticate",
          "params": {
            "token": "invalid-${HOST_TOKEN}",
            "protocolVersion": 1,
            "clientId": "ConformanceWsInvalidToken",
            "clientSessionId": "20000000-0000-0000-0000-000000000001"
          }
        }
      },
      {
        "action": "receive",
        "captureAs": "response"
      },
      {
        "action": "wait_closed",
        "captureAs": "closed",
        "timeoutMs": 1500
      }
    ]
  },
  "expectedResponse": {
    "phase": "ws",
    "outcome": "success",
    "actual": {
      "response": {
        "jsonrpc": "2.0",
        "id": "ws-auth-invalid-token",
        "error": {
          "code": -32001,
          "message": "unauthorized",
          "data": {
            "reason": "invalid_token"
          }
        }
      },
      "closed": {
        "closed": true
      }
    }
  },
  "tags": [
    "errors",
    "ws",
    "auth"
  ]
}
