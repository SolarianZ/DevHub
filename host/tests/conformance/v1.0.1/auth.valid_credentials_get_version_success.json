{
  "id": "auth.valid_credentials_get_version_success",
  "caseId": "CONF-002",
  "description": "携带有效 token 与必需请求头时，hub.getVersion 必须成功。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "Conformance",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000011"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "auth-valid-get-version",
    "method": "hub.getVersion",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "auth-valid-get-version",
    "result": {
      "ok": true,
      "version": "${ANY_NON_EMPTY_STRING}"
    }
  },
  "tags": [
    "auth",
    "http",
    "success"
  ]
}
