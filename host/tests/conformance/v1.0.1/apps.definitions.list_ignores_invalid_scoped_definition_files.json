{
  "id": "apps.definitions.list_ignores_invalid_scoped_definition_files",
  "caseId": "CONF-003",
  "description": "存在旧命名、缺失 scope、空 scope 或空白 scope 的 persisted Definition 文件时，hub.apps.listDefinitions 必须忽略这些无效记录。",
  "transport": "http",
  "setup": {
    "definitions": [
      {
        "fileName": "apps.list.valid-scoped.app--global.json",
        "definition": {
          "appId": "apps.list.valid-scoped.app",
          "scope": null,
          "displayName": "Apps List Valid Scoped"
        }
      },
      {
        "fileName": "apps.list.invalid-legacy.app.json",
        "definition": {
          "appId": "apps.list.invalid-legacy.app",
          "scope": null,
          "displayName": "Apps List Invalid Legacy"
        }
      },
      {
        "fileName": "apps.list.invalid-missing-scope.app--global.json",
        "rawText": "{\"appId\":\"apps.list.invalid-missing-scope.app\",\"displayName\":\"Apps List Invalid Missing Scope\"}"
      },
      {
        "fileName": "apps.list.invalid-empty-scope.app--global.json",
        "definition": {
          "appId": "apps.list.invalid-empty-scope.app",
          "scope": "",
          "displayName": "Apps List Invalid Empty Scope"
        }
      },
      {
        "fileName": "apps.list.invalid-whitespace-scope.app--202020.json",
        "definition": {
          "appId": "apps.list.invalid-whitespace-scope.app",
          "scope": "   ",
          "displayName": "Apps List Invalid Whitespace Scope"
        }
      }
    ]
  },
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000129"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-list-ignore-invalid-scoped-files",
    "method": "hub.apps.listDefinitions",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-definitions-list-ignore-invalid-scoped-files",
    "result": {
      "ok": true,
      "definitions": [
        {
          "appId": "apps.list.valid-scoped.app",
          "scope": null,
          "displayName": "Apps List Valid Scoped"
        }
      ]
    }
  },
  "tags": [
    "apps",
    "definitions",
    "http",
    "invalid-definition"
  ]
}
