          "scope": null,
          "displayName": "invoke.notify.target-missing"
        }
      }
    ]
  },
  "request": {
    "kind": "sdk.notify",
    "clientId": "ConformanceNotifyTargetMissing",
    "invokeRequest": {
      "appId": "invoke.notify.target-missing",
      "method": "demo.notify.target-missing",
      "target": {
        "instanceId": "notify-target-missing-inst"
      },
      "options": {
        "queueIfOffline": false
      }
    }
  },
  "expectedResponse": {
