{
  "id": "auth.missing_token_returns_unauthorized",
  "caseId": "M5-CONF-002",
  "description": "缺失 Authorization 时，Hub 必须返回 unauthorized/missing_token。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "Conformance",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000002"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "auth-missing-token",
    "method": "hub.ping",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "auth-missing-token",
    "error": {
      "code": -32001,
      "message": "unauthorized",
      "data": {
        "reason": "missing_token"
      }
    }
  },
  "tags": [
    "auth",
    "http",
    "negative"
  ]
}
