{
  "id": "errors.internal_error_fault_injection_returns_internal_error",
  "caseId": "CONF-008",
  "description": "测试故障注入命中的请求 ID 必须稳定返回 internal_error，而不引入非规范 RPC 方法。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceInternalError",
      "X-DevHub-ClientSessionId": "30000000-0000-0000-0000-000000000005"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "http-internal-error",
    "method": "hub.ping",
    "params": {
      "echo": "force-internal-error"
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "http-internal-error",
    "error": {
      "code": -32603,
      "message": "internal_error"
    }
  },
  "tags": [
    "errors",
    "http",
    "internal"
  ]
}
