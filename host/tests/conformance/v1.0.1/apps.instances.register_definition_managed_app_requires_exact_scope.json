{
  "id": "apps.instances.register_definition_managed_app_requires_exact_scope",
  "caseId": "CONF-003",
  "description": "当 appId 已受 Definition 管理时，hub.apps.registerInstance 必须拒绝未声明的 scope。",
  "transport": "http",
  "setup": {
    "definitions": [
      {
        "fileName": "apps.instance.managed-scope.app--73636F70652D61.json",
        "definition": {
          "appId": "apps.instance.managed-scope.app",
          "scope": "scope-a",
          "displayName": "Apps Instance Managed Scope A"
        }
      }
    ]
  },
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000125"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-instances-register-managed-scope",
    "method": "hub.apps.registerInstance",
    "params": {
      "password": "conformance-password",
      "instance": {
        "instanceId": "apps-instance-managed-scope-b",
        "appId": "apps.instance.managed-scope.app",
        "scope": "scope-b",
        "pid": 32021,
        "invoke": {
          "poll": true,
          "respond": true
        }
      }
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-instances-register-managed-scope",
    "error": {
      "code": -32014,
      "message": "app_definition_not_found",
      "data": {
        "appId": "apps.instance.managed-scope.app",
        "scope": "scope-b"
      }
    }
  },
  "tags": [
    "apps",
    "instances",
    "http",
    "scope",
    "error"
  ]
}
