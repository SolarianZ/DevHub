  "description": "SDK request 在无 helper 在线、ttlMs==waitTimeoutMs==1000 且允许排队时，必须返回 invocation_expired。",
  "transport": "http",
  "setup": {
    "definitions": [
      {
        "appId": "invoke.request.expired",
        "scopeEntry": {
          "scope": "",
          "displayName": "invoke.request.expired"
        }
      }
    ]
  },
  "request": {
    "kind": "sdk.request",
    "clientId": "ConformanceRequestExpired",
    "invokeRequest": {
      "appId": "invoke.request.expired",
      "method": "demo.request.expired",
      "options": {
        "ttlMs": 1000,
        "waitTimeoutMs": 1000,
        "queueIfOffline": true,
        "autoLaunch": false
      },
      "target": {
        "scope": ""
      }
    }
  },
  "expectedResponse": {
    "phase": "sdk-invocation",
    "operation": "request",
    "outcome": "error",
