{
  "id": "auth.notification_missing_token_returns_unauthorized",
  "caseId": "CONF-002",
  "description": "HTTP notification 缺失 Authorization 时，Hub 必须先执行传输层鉴权并返回 unauthorized。",
  "transport": "http",
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "Conformance",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000202"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "method": "hub.ping",
    "params": {}
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": null,
    "error": {
      "code": -32001,
      "message": "unauthorized",
      "data": {
        "reason": "missing_token"
      }
    }
  },
  "tags": [
    "auth",
    "http",
    "notification",
    "negative"
  ]
}
