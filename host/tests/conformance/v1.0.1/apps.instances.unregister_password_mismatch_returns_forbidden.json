{
  "id": "apps.instances.unregister_password_mismatch_returns_forbidden",
  "caseId": "CONF-003",
  "description": "已注册 instanceId 以错误 password 调用 hub.apps.unregisterInstance 时，必须返回 instance_password_mismatch，且保留原状态。",
  "transport": "http",
  "setup": {
    "instances": [
      {
        "state": "registered",
        "password": "correct-password",
        "instance": {
          "instanceId": "apps-instance-unregister-guard",
          "appId": "apps.instance.unregister.guard.app",
          "scope": "workspace-unregister-guard",
          "pid": 32014,
          "invoke": {
            "poll": true,
            "respond": true
          }
        }
      }
    ]
  },
  "orchestration": {
    "afterCaller": [
      {
        "action": "call_rpc",
        "method": "hub.apps.listInstances",
        "requestId": "apps-instances-unregister-mismatch-list",
        "params": {
          "appId": "apps.instance.unregister.guard.app",
          "includeOffline": true,
          "scope": null
        },
        "expectedResult": {
          "ok": true,
          "instances": [
            {
              "instanceId": "apps-instance-unregister-guard",
              "appId": "apps.instance.unregister.guard.app",
              "scope": "workspace-unregister-guard",
              "pid": 32014,
              "invoke": {
                "poll": true,
                "respond": true
              }
            }
          ]
        }
      }
    ]
  },
  "http": {
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${HOST_TOKEN}",
      "X-DevHub-Protocol": "1",
      "X-DevHub-ClientId": "ConformanceApps",
      "X-DevHub-ClientSessionId": "00000000-0000-0000-0000-000000000040"
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": "apps-instances-unregister-password-mismatch",
    "method": "hub.apps.unregisterInstance",
    "params": {
      "instanceId": "apps-instance-unregister-guard",
      "password": "wrong-password"
    }
  },
  "expectedResponse": {
    "jsonrpc": "2.0",
    "id": "apps-instances-unregister-password-mismatch",
    "error": {
      "code": -32002,
      "message": "forbidden",
      "data": {
        "reason": "instance_password_mismatch",
        "instanceId": "apps-instance-unregister-guard"
      }
    }
  },
  "tags": [
    "apps",
    "instances",
    "http",
    "error"
  ]
}
