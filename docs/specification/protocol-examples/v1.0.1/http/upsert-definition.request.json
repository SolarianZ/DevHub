{
  "jsonrpc": "2.0",
  "id": "apps-definitions-upsert",
  "method": "hub.apps.upsertDefinition",
  "params": {
    "definition": {
      "appId": "Sample.App",
      "scope": "",
      "displayName": "Sample App",
      "launch": {
        "exePath": "/opt/devhub-samples/sample-app",
        "args": [
          "--app",
          "{appId}",
          "--scope",
          "{scopeOrGlobal}"
        ]
      }
    }
  }
}
