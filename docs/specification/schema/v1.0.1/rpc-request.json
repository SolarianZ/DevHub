{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/rpc-request.json",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {}
  },
  "allOf": [
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "const": "hub.ping"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "const": "hub.getVersion"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "not": {
              "enum": [
                "hub.ping",
                "hub.getVersion"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "hub.invoke.respond"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "leaseToken"
            ],
            "properties": {
              "leaseToken": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
