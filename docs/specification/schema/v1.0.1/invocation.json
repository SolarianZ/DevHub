{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/invocation.json",
  "type": "object",
  "required": [
    "invocationId",
    "appId",
    "target",
    "method",
    "kind",
    "createdAtUtc",
    "caller"
  ],
  "properties": {
    "invocationId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^invk-[a-zA-Z0-9._:-]+$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "target": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "description": "Target scope. Use the empty string to explicitly target Global. Any other legal string must satisfy the canonical DevHub identifier grammar and is preserved verbatim.",
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
        }
      }
    },
    "method": {
      "type": "string"
    },
    "args": {
      "description": "Any valid JSON value is allowed (object/array/string/number/boolean/null)."
    },
    "kind": {
      "type": "string",
      "enum": [
        "request",
        "notify"
      ]
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "options": {
      "type": "object",
      "properties": {
        "ttlMs": {
          "type": "integer",
          "minimum": 1000
        },
        "waitTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "queueIfOffline": {
          "type": "boolean"
        },
        "autoLaunch": {
          "type": "boolean"
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "caller": {
      "type": "object",
      "required": [
        "clientId",
        "clientSessionId"
      ],
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientSessionId": {
          "description": "Caller session identifier. Must be a canonical UUID string.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    }
  }
}
