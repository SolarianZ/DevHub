{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/rpc-notification.json",
  "type": "object",
  "required": [
    "jsonrpc",
    "method"
  ],
  "not": {
    "required": [
      "id"
    ]
  },
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {}
  },
  "allOf": [
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "const": "hub.ping"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "const": "hub.getVersion"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "params"
        ],
        "properties": {
          "method": {
            "not": {
              "enum": [
                "hub.ping",
                "hub.getVersion"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object"
          }
        }
      }
    }
  ]
}
