{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/event-notification.json",
  "type": "object",
  "required": [
    "jsonrpc",
    "method",
    "params"
  ],
  "not": {
    "required": [
      "id"
    ]
  },
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "hub.event"
      ]
    },
    "params": {
      "type": "object",
      "required": [
        "subscriptionId",
        "type",
        "timeUtc",
        "payload"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "timeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
