{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/event-notification.json",
  "type": "object",
  "required": [
    "jsonrpc",
    "method",
    "params"
  ],
  "not": {
    "required": [
      "id"
    ]
  },
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "hub.event"
      ]
    },
    "params": {
      "type": "object",
      "required": [
        "subscriptionId",
        "type",
        "timeUtc",
        "payload"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "app.definition.upserted",
            "app.definition.deleted",
            "app.instance.registered",
            "app.instance.unregistered",
            "invocation.queued",
            "invocation.delivered",
            "invocation.completed",
            "invocation.failed"
          ]
        },
        "timeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "scope": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "instanceId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "nullableInstanceId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "invocationId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^invk-[a-zA-Z0-9._:-]+$"
    },
    "target": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "instanceId": {
          "$ref": "#/definitions/nullableInstanceId"
        }
      }
    },
    "deliveryAttempt": {
      "type": "object",
      "required": [
        "attempt"
      ],
      "not": {
        "required": [
          "leaseToken"
        ]
      },
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "appDefinition": {
      "type": "object",
      "required": [
        "appId",
        "scope",
        "displayName"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "displayName": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "rpc": {
              "type": "boolean"
            },
            "events": {
              "type": "boolean"
            }
          }
        },
        "launch": {
          "type": "object",
          "properties": {
            "exePath": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "argsTemplate": {
              "type": "string"
            },
            "workingDirectory": {
              "type": "string"
            },
            "dedupeKeyTemplate": {
              "type": "string"
            }
          }
        }
      }
    },
    "appDefinitionUpsertedPayload": {
      "type": "object",
      "required": [
        "appId",
        "scope",
        "definition"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "definition": {
          "description": "Must satisfy AppDefinition. Per Specification, definition.scope must equal payload.scope.",
          "$ref": "#/definitions/appDefinition"
        }
      }
    },
    "appDefinitionDeletedPayload": {
      "type": "object",
      "required": [
        "appId",
        "scope"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        }
      }
    },
    "appInstanceLifecyclePayload": {
      "type": "object",
      "required": [
        "appId",
        "instanceId",
        "scope"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "instanceId": {
          "$ref": "#/definitions/instanceId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "password"
            ]
          }
        },
        {
          "not": {
            "required": [
              "instanceSessionToken"
            ]
          }
        }
      ]
    },
    "invocationQueuedPayload": {
      "type": "object",
      "required": [
        "invocationId",
        "appId",
        "target",
        "method",
        "kind"
      ],
      "properties": {
        "invocationId": {
          "$ref": "#/definitions/invocationId"
        },
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "method": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "request",
            "notify"
          ]
        }
      }
    },
    "invocationDeliveredPayload": {
      "type": "object",
      "required": [
        "invocationId",
        "appId",
        "target",
        "instanceId",
        "delivery"
      ],
      "properties": {
        "invocationId": {
          "$ref": "#/definitions/invocationId"
        },
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "instanceId": {
          "$ref": "#/definitions/instanceId"
        },
        "delivery": {
          "$ref": "#/definitions/deliveryAttempt"
        }
      }
    },
    "invocationCompletedPayload": {
      "type": "object",
      "required": [
        "invocationId",
        "appId",
        "target",
        "instanceId"
      ],
      "properties": {
        "invocationId": {
          "$ref": "#/definitions/invocationId"
        },
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "instanceId": {
          "$ref": "#/definitions/instanceId"
        }
      }
    },
    "invocationFailedPayload": {
      "type": "object",
      "required": [
        "invocationId",
        "appId",
        "target",
        "instanceId",
        "reason"
      ],
      "properties": {
        "invocationId": {
          "$ref": "#/definitions/invocationId"
        },
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "instanceId": {
          "$ref": "#/definitions/instanceId"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "app.definition.upserted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appDefinitionUpsertedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "app.definition.deleted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appDefinitionDeletedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "enum": [
                  "app.instance.registered",
                  "app.instance.unregistered"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appInstanceLifecyclePayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "invocation.queued"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/invocationQueuedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "invocation.delivered"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/invocationDeliveredPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "invocation.completed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/invocationCompletedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "invocation.failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/invocationFailedPayload"
              }
            }
          }
        }
      }
    }
  ]
}
