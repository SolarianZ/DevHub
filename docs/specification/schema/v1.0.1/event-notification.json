{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/event-notification.json",
  "type": "object",
  "required": [
    "jsonrpc",
    "method",
    "params"
  ],
  "not": {
    "required": [
      "id"
    ]
  },
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "hub.event"
      ]
    },
    "params": {
      "type": "object",
      "required": [
        "subscriptionId",
        "type",
        "timeUtc",
        "payload"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "app.definition.upserted",
            "app.definition.deleted",
            "app.instance.registered",
            "app.instance.unregistered",
            "invocation.queued",
            "invocation.delivered",
            "invocation.completed",
            "invocation.failed"
          ]
        },
        "timeUtc": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "scope": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "appDefinition": {
      "type": "object",
      "required": [
        "appId",
        "scope",
        "displayName"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "rpc": {
              "type": "boolean"
            },
            "events": {
              "type": "boolean"
            }
          }
        },
        "launch": {
          "type": "object",
          "required": [
            "exePath"
          ],
          "properties": {
            "exePath": {
              "type": "string"
            },
            "argsTemplate": {
              "type": "string"
            },
            "workingDirectory": {
              "type": "string"
            },
            "dedupeKeyTemplate": {
              "type": "string"
            }
          }
        }
      }
    },
    "appDefinitionUpsertedPayload": {
      "type": "object",
      "required": [
        "appId",
        "scope",
        "definition"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "definition": {
          "description": "Must satisfy AppDefinition. Per Specification, definition.scope must equal payload.scope.",
          "$ref": "#/definitions/appDefinition"
        }
      }
    },
    "appDefinitionDeletedPayload": {
      "type": "object",
      "required": [
        "appId",
        "scope"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        }
      }
    },
    "appInstanceLifecyclePayload": {
      "type": "object",
      "required": [
        "appId",
        "instanceId"
      ],
      "properties": {
        "appId": {
          "$ref": "#/definitions/appId"
        },
        "instanceId": {
          "$ref": "#/definitions/instanceId"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "password"
            ]
          }
        },
        {
          "not": {
            "required": [
              "instanceSessionToken"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "app.definition.upserted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appDefinitionUpsertedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "const": "app.definition.deleted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appDefinitionDeletedPayload"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "params": {
            "properties": {
              "type": {
                "enum": [
                  "app.instance.registered",
                  "app.instance.unregistered"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/appInstanceLifecyclePayload"
              }
            }
          }
        }
      }
    }
  ]
}
