{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devhub.spec/v1/app-instance-registration.json",
  "type": "object",
  "required": [
    "instanceId",
    "appId",
    "scope",
    "pid",
    "invoke"
  ],
  "properties": {
    "instanceId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "scope": {
      "description": "Registration scope. Use the empty string for the Global scope. Any other scope must satisfy the canonical DevHub identifier grammar and is preserved verbatim.",
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "invoke": {
      "type": "object",
      "required": [
        "poll",
        "respond"
      ],
      "properties": {
        "poll": {
          "type": "boolean"
        },
        "respond": {
          "type": "boolean"
        }
      }
    },
    "meta": {
      "type": "object"
    }
  }
}
